# Pegar en Environment de Dokploy; reemplazar los tres valores.
FRONTEND_ORIGIN=https://deportes.undc.edu.pe
# Generar dos secretos DIFERENTES de 64 caracteres hexadecimales.
# Solo hexadecimal evita caracteres reservados en DATABASE_URL.
MYSQL_PASSWORD=REEMPLAZAR_POR_SECRETO_HEXADECIMAL
MYSQL_ROOT_PASSWORD=REEMPLAZAR_POR_OTRO_SECRETO_HEXADECIMAL
